#!/usr/bin/env node
// Tiny launcher: postinstall downloads the matching binary as ./clite or
// ./clite.exe alongside this script; we just exec it with the same argv.
//
// On Windows npm generates a clite.cmd shim that runs `node ./bin/clite`,
// so this single file is the cross-platform entry point.
//
// Spec: architecture.md §15.9.6.

'use strict';

const path = require('path');
const fs = require('fs');
const { spawnSync } = require('child_process');

const isWindows = process.platform === 'win32';
const binName = isWindows ? 'clite.exe' : 'clite';
const binPath = path.join(__dirname, binName);

if (!fs.existsSync(binPath)) {
  console.error(
    '[clite] binary not found at ' + binPath + '. ' +
      'Re-run `npm install -g @gaev-tech/clite --registry https://registry.npmjs.org/`, ' +
      'or install via another channel: https://apitracker.ru/installation',
  );
  process.exit(127);
}

const result = spawnSync(binPath, process.argv.slice(2), {
  stdio: 'inherit',
});

if (result.error) {
  console.error('[clite] failed to spawn binary: ' + result.error.message);
  process.exit(1);
}

process.exit(result.status === null ? 1 : result.status);
