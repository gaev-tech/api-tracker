{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "auth-client": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "changeDetection": "OnPush",
          "standalone": true
        }
      },
      "root": "projects/auth-client",
      "sourceRoot": "projects/auth-client/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/auth-client",
            "index": "projects/auth-client/src/index.html",
            "browser": "projects/auth-client/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/auth-client/tsconfig.app.json",
            "styles": ["projects/auth-client/src/styles.scss"],
            "scripts": []
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "auth-client:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "projects/auth-client/tsconfig.spec.json",
            "styles": ["projects/auth-client/src/styles.scss"]
          }
        }
      }
    },
    "docs-client": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "changeDetection": "OnPush",
          "standalone": true
        }
      },
      "root": "projects/docs-client",
      "sourceRoot": "projects/docs-client/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/docs-client",
            "index": "projects/docs-client/src/index.html",
            "browser": "projects/docs-client/src/main.ts",
            "polyfills": [],
            "tsConfig": "projects/docs-client/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/docs-client/src/assets",
                "output": "/assets"
              }
            ],
            "styles": ["projects/docs-client/src/styles.scss"],
            "scripts": []
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "docs-client:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "projects/docs-client/tsconfig.spec.json",
            "styles": ["projects/docs-client/src/styles.scss"]
          }
        }
      }
    }
  }
}
