{
  "components": {
    "schemas": {
      "CliCodeRequest": {
        "additionalProperties": false,
        "properties": {
          "code_challenge": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Code Challenge",
            "type": "string"
          },
          "state": {
            "maxLength": 128,
            "minLength": 8,
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "code_challenge"
        ],
        "title": "CliCodeRequest",
        "type": "object"
      },
      "CliCodeResponse": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "CliCodeResponse",
        "type": "object"
      },
      "CliExchangeRequest": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "code_verifier": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Code Verifier",
            "type": "string"
          }
        },
        "required": [
          "code",
          "code_verifier"
        ],
        "title": "CliExchangeRequest",
        "type": "object"
      },
      "CliRefreshRequest": {
        "additionalProperties": false,
        "properties": {
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "CliRefreshRequest",
        "type": "object"
      },
      "DeviceApproveRequest": {
        "additionalProperties": false,
        "properties": {
          "user_code": {
            "maxLength": 20,
            "minLength": 8,
            "title": "User Code",
            "type": "string"
          }
        },
        "required": [
          "user_code"
        ],
        "title": "DeviceApproveRequest",
        "type": "object"
      },
      "DevicePollRequest": {
        "additionalProperties": false,
        "properties": {
          "device_code": {
            "title": "Device Code",
            "type": "string"
          }
        },
        "required": [
          "device_code"
        ],
        "title": "DevicePollRequest",
        "type": "object"
      },
      "DeviceStartResponse": {
        "properties": {
          "device_code": {
            "title": "Device Code",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "interval": {
            "title": "Interval",
            "type": "integer"
          },
          "user_code": {
            "title": "User Code",
            "type": "string"
          },
          "verification_url": {
            "title": "Verification Url",
            "type": "string"
          }
        },
        "required": [
          "device_code",
          "user_code",
          "verification_url",
          "interval",
          "expires_in"
        ],
        "title": "DeviceStartResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MagicStartRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "intent": {
            "$ref": "#/components/schemas/MagicTokenIntent",
            "default": "browser"
          }
        },
        "required": [
          "email"
        ],
        "title": "MagicStartRequest",
        "type": "object"
      },
      "MagicStartResponse": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "sent": {
            "title": "Sent",
            "type": "boolean"
          }
        },
        "required": [
          "sent",
          "email"
        ],
        "title": "MagicStartResponse",
        "type": "object"
      },
      "MagicTokenIntent": {
        "enum": [
          "browser",
          "cli"
        ],
        "title": "MagicTokenIntent",
        "type": "string"
      },
      "MagicVerifyRequest": {
        "additionalProperties": false,
        "properties": {
          "intent": {
            "$ref": "#/components/schemas/MagicTokenIntent",
            "default": "browser"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "MagicVerifyRequest",
        "type": "object"
      },
      "MagicVerifyResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user_email": {
            "title": "User Email",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "expires_in",
          "user_email"
        ],
        "title": "MagicVerifyResponse",
        "type": "object"
      },
      "SessionTokens": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "expires_in"
        ],
        "title": "SessionTokens",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "api-tracker auth-service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
